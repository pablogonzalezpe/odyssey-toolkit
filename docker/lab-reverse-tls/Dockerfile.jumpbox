FROM alpine:3.20
RUN apk add --no-cache gcc musl-dev make linux-headers pkgconf openssl-dev openssl
COPY include/ /build/include/
COPY src/ /build/src/
COPY Makefile /build/
WORKDIR /build
RUN make && \
    cp bin/odyssey /usr/local/bin/odyssey && \
    rm -rf /build
RUN printf 'odyssey-lab-token!' > /root/token.txt
COPY docker/lab-reverse-tls/entrypoint-jumpbox.sh /root/entrypoint.sh
RUN chmod +x /root/entrypoint.sh
CMD ["/root/entrypoint.sh"]
