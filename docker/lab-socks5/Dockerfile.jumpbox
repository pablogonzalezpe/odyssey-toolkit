FROM alpine:3.20
RUN apk add --no-cache gcc musl-dev make linux-headers
COPY include/ /build/include/
COPY src/ /build/src/
COPY Makefile /build/
WORKDIR /build
RUN make CFLAGS="-O2 -Wall -Wextra -Wpedantic -std=c11 -Iinclude" && \
    cp bin/odyssey /usr/local/bin/odyssey && \
    rm -rf /build
RUN printf 'odyssey-lab-token!' > /root/token.txt
CMD ["odyssey", "reverse-client", \
     "--connect", "10.10.10.3:9001", \
     "--token-file", "/root/token.txt", \
     "--tls-mode", "disabled"]
